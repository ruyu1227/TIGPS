# 2. 負值、空白及非數字轉NA
# 問卷常見的缺失／拒答代碼為負值或空白，統一轉成NA方便後續計分函數判斷完整性
# ==================================================
item_data[] <- lapply(item_data, function(z) {
  z <- suppressWarnings(as.numeric(trimws(as.character(z))))
  z[!is.finite(z) | z < 0] <- NA_real_
  z
})


# ==================================================
# 3. 計分函數
# get_items()：檢查小題是否落在合理範圍內的整數，不符合者視為缺失
# mean_score()：要求該題組所有小題都有效才計算平均（避免用部分題目硬湊分數）
# count_selected()：計算複選題中勾選的項目數，並處理「以上均無」選項的邏輯矛盾
# ==================================================

# 取出有效範圍內的小題，超出範圍、非整數者設為NA
get_items <- function(vars, min_value, max_value) {
  x <- item_data[, vars, drop = FALSE]
  x[] <- lapply(x, function(z) {
    z[!is.finite(z) | z < min_value | z > max_value | z != floor(z)] <- NA_real_
    z
  })
  x
}

# 所有小題皆有效才計算平均
mean_score <- function(vars, min_value = 1, max_value = 4) {
  rowMeans(get_items(vars, min_value, max_value), na.rm = FALSE)
}

# 計算勾選種類數，不計入「以上均無」
count_selected <- function(vars, none_var) {
  x <- get_items(c(vars, none_var), 0, 1)
  count <- rowSums(x[, vars, drop = FALSE] == 1, na.rm = FALSE)
  count[is.na(x[[none_var]])] <- NA_real_                 # 「以上均無」欄位缺失，整題視為不完整
  conflict <- which(x[[none_var]] == 1 & count > 0)
  count[conflict] <- NA_real_                              # 同時勾選具體項目與「以上均無」：矛盾作答
  count
}


