)
forest_data <- merge(forest_data, forest_labels, by = "term", all.x = TRUE)

# 依OR大小排序（兩個面板共用同一個順序，才會上下對得齊）
forest_data$中文標籤 <- factor(
  forest_data$中文標籤,
  levels = forest_data$中文標籤[order(forest_data$estimate)]
)

# 95%信賴區間是否跨過OR=1（1代表沒有效果），作為顯著與否的視覺標示
forest_data$顯著 <- ifelse(
  forest_data$conf.low > 1 | forest_data$conf.high < 1,
  "顯著", "不顯著"
)

# OR(95%CI)文字欄位，放進右側文字面板
forest_data$or_text <- sprintf(
  "%.2f (%.2f, %.2f)",
  forest_data$estimate, forest_data$conf.low, forest_data$conf.high
)

# ------------------------------------------------
# 左面板：森林圖本體（點 + 誤差線，log尺度呈現OR）
# ------------------------------------------------
panel_plot <- ggplot(
  forest_data,
  aes(x = estimate, y = 中文標籤, color = 顯著)
) +
  geom_vline(xintercept = 1, linetype = "dashed", color = "grey50") +
  geom_errorbarh(aes(xmin = conf.low, xmax = conf.high), height = 0.2, linewidth = 0.7) +
  geom_point(size = 3) +
  scale_color_manual(values = c("顯著" = "#D1495B", "不顯著" = "#9CA8C4")) +
  scale_x_log10(breaks = c(0.5, 1, 2, 4, 8)) +
  labs(x = "Odds Ratio", y = NULL, color = NULL) +
  theme_minimal(base_size = 15) +
  theme(
    panel.grid.minor = element_blank(),
    legend.position = "bottom"
  )

# ------------------------------------------------
# 右面板：純文字表格（OR(95%CI)），y軸順序跟左面板一致，確保每一列對齊
# ------------------------------------------------
table_plot <- ggplot(
  forest_data,
  aes(y = 中文標籤)
) +
  geom_text(aes(x = 0, label = or_text), hjust = 0, size = 4) +
  xlim(0, 1) +
  theme_void(base_size = 15) +
  theme(
    axis.text.y = element_blank(),
    plot.margin = margin(t = 10, r = 10, b = 10, l = 0)
  )

# ------------------------------------------------
# 拼接：左面板（圖形）較寬，右面板（文字表）較窄
# ------------------------------------------------
forest_plot <- panel_plot + table_plot + plot_layout(widths = c(2.5, 1))

print(forest_plot)

ggsave(
  "forest_plot.png",
  plot = forest_plot,
  width = 10,
  height = max(5, nrow(forest_data) * 0.4),
  dpi = 300
)
