# 計算Cohen's d的通用函數：對每個變數分別比較高高組(y==1)與其他組(y==0)的平均差異，
# 以兩組合併標準差（pooled SD）作為標準化分母；任一組人數不足2人則回傳NA
compute_cohens_d <- function(data, vars, group_var) {
  do.call(rbind, lapply(vars, function(v) {
    x <- data[[v]]
    y <- data[[group_var]]
    x1 <- x[which(y == 1 & is.finite(x))]
    x0 <- x[which(y == 0 & is.finite(x))]
    n1 <- length(x1)
    n0 <- length(x0)
    d <- NA_real_
    if (n1 >= 2 && n0 >= 2) {
      pooled_sd <- sqrt(((n1 - 1) * var(x1) + (n0 - 1) * var(x0)) / (n1 + n0 - 2))
      if (is.finite(pooled_sd) && pooled_sd > 0) {
        d <- (mean(x1) - mean(x0)) / pooled_sd
      }
    }
    data.frame(
      變數代碼 = v,
      高高組人數 = n1,
      其他組人數 = n0,
      高高組平均 = mean(x1),
      其他組平均 = mean(x0),
      cohens_d = d,
      絕對值d = abs(d)
    )
  }))
}

