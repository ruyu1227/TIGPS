# ==================================================
# 1. 刪除指定題目
# 刪除與本研究主題無關、或因結構特殊（如時間欄位、補習科目矩陣）不適合直接計分的題目
# ==================================================
question_number <- as.integer(
  sub("^bs([0-9]+).*", "\\1", names(item_data))
)

# 刪除整題及其所有小題
drop_questions <- c(2, 13, 14, 35, 37, 39, 41, 62, 63, 64)
