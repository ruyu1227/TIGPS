# 12-1. 類別變項：卡方檢定 + Cramér's V
# Cohen's d僅適用於連續變項，對象為categorical_vars（名目尺度題目）另以卡方檢定
# 搭配Cramér's V（效果量）評估其與依變項high_high的關聯強度
# ==================================================
compute_cramers_v <- function(data, vars, group_var) {
  do.call(rbind, lapply(vars, function(v) {
    x <- data[[v]]
    y <- data[[group_var]]
    valid <- is.finite(x) & is.finite(y)
    x <- x[valid]
    y <- y[valid]
    
    tab <- table(x, y)
    n <- sum(tab)
    
    # 類別數太少（例如篩完只剩一個類別）無法檢定
    if (nrow(tab) < 2 || ncol(tab) < 2 || n < 2) {
      return(data.frame(
        變數代碼 = v, 有效人數 = n, 類別數 = nrow(tab),
        chi_sq = NA_real_, 自由度 = NA_real_, p值 = NA_real_,
        cramers_v = NA_real_, 期望次數小於5比例 = NA_real_
      ))
    }
    
    chi <- suppressWarnings(chisq.test(tab, correct = FALSE))
    expected_low <- mean(chi$expected < 5)                 # 期望次數<5的比例，太高時卡方近似可能不準
    k <- min(nrow(tab), ncol(tab))
    v_val <- sqrt(unname(chi$statistic) / (n * (k - 1)))
    
    data.frame(
      變數代碼 = v,
      有效人數 = n,
      類別數 = nrow(tab),
      chi_sq = unname(chi$statistic),
      自由度 = unname(chi$parameter),
      p值 = chi$p.value,
      cramers_v = v_val,
      期望次數小於5比例 = round(expected_low * 100, 1)
    )
  }))
}

