    }
    if (g == "bs6") {
      reverse_6 <- c("bs6a", "bs6e", "bs6f", "bs6h", "bs6i") # 批評指責、不聞不問、衝突緊張、處罰不一致、體罰
      x[reverse_6] <- lapply(x[reverse_6], function(z) 5 - z)
    }
    score <- rowMeans(x, na.rm = FALSE)                      # 小題完整才計算平均
    d_data <- d_data[, setdiff(names(d_data), vars), drop = FALSE]
    d_data[[g]] <- score                                     # 刪除小題欄位，換成一個題組分數
  } else if (!(g %in% names(d_data))) {
    stop(paste("缺少題組欄位，請檢查：", g))
  }
}


