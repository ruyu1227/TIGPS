# ==================================================
parent_vars <- c("bs20a_active", "bs20a_restrict", "bs20b_active", "bs20b_restrict")

combine_parents <- function(father, mother) {
  score <- rowMeans(cbind(father, mother), na.rm = TRUE)
  score[is.nan(score)] <- NA_real_                         # 兩位都缺失時，rowMeans會產生NaN，改為NA
  score
}

