# ==================================================
# 0-1. 資料讀取
# 用file.choose()讓使用者自行選取原始CSV檔；
# 問卷題目欄位統一以「bs」開頭＋題號命名（例如bs23a），以此規則篩出所有題目欄位
# ==================================================
raw_data <- read.csv(
  file.choose(),
  stringsAsFactors = FALSE,
  check.names = FALSE
