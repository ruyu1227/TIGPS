#  =================================================================
#  主題名稱：高素養，反而深陷網路沉迷：青少年數位素養與網路沉迷
#  資料庫：臺灣數位世代青少年的成長歷程追蹤研究（TIGPS）
#  團隊隊名：肆無忌憚
#  ------------------------------------------------------------------
#  本程式碼完整流程：
#    0.  讀入原始問卷資料，篩出問卷題目欄位
#    1.  刪除不納入分析的題目／小題
#    2.  清理無效值（負值、空白、非數字）為NA
#    3.  定義通用計分函數（平均分數、勾選題計數）
#    4.  處理反向計分題與S46重新編碼
#    5.  依題意合併小題，建立各題組的分數欄位
#    6.  在樣本篩選前，先計算兩個關鍵量表（素養、成癮）的中位數切點
#    7.  用題組分數取代其原始小題，整理成分析用資料表
#    8.  合併父母雙方分數（放寬「兩位家長都要答」的限制，增加有效樣本）
#    9.  篩出全變數完整作答的最終樣本，並依中位數切點做高／低分組
#    10. 題組（含尚未合併的小題）計算Cohen's d，比較高高組與其他組
#    11. 將剩餘小題進一步合併成題組分數（題組層級分析用）
#    12. 重新計算題組層級的Cohen's d
#    12-1～12-2. 類別變項以卡方檢定＋Cramér's V篩選顯著關聯
#    13. 篩選效果量 |Cohen's d| > 0.2 的連續變項
#    14. 以篩選後的變項建立邏輯斯回歸模型，並檢查共線性（VIF）
#    15. 繪製Cohen's d棒棒糖圖（含六大類顏色、正負向形狀標示）
#    16. 繪製素養×成癮四象限散佈圖（含各象限人數與百分比標籤）
#    17. 繪製邏輯斯回歸森林圖（Odds Ratio + 95%CI，左圖右表雙面板拼接）
#
#  使用套件：ggplot2（繪圖）、car（VIF共線性檢查）、broom（整理模型係數）、
#            patchwork（森林圖左右面板拼接），皆於程式中自動偵測並安裝
#  輸出檔案：cohens_d_lollipop.png、quadrant_scatter.png、forest_plot.png
#  =================================================================


# ==================================================
# 0. 套件載入
# 統一在程式最前面載入全部用到的套件，不足則自動安裝：
#   car（14-1步VIF共線性檢查）、ggplot2（15～17步繪圖）、
#   broom（17步整理glm模型係數）、patchwork（17步森林圖左右面板拼接）
# ==================================================
required_packages <- c("car", "ggplot2", "broom", "patchwork")
for (pkg in required_packages) {
  if (!requireNamespace(pkg, quietly = TRUE)) install.packages(pkg)
}
library(car)
library(ggplot2)
library(broom)
